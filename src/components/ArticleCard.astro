---
import type { Article } from '../data/articles';
const { a } = Astro.props as { a: Article };
---
<article class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-600/10">
  <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
    <span class="rounded-full bg-brand-100 px-3 py-1 text-brand-800">{a.category}</span>
    <time class="text-slate-500">{a.date}</time>
  </div>
  <h3 class="mt-4 text-xl font-extrabold leading-snug"><a href={a.url} class="hover:text-brand-700">{a.title}</a></h3>
  <p class="mt-3 flex-1 text-base leading-7">{a.excerpt}</p>
  <a href={a.url} class="mt-5 text-sm font-bold text-brand-700">Read article <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">→</span></a>
</article>

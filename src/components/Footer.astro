---
import { nav } from './nav';
---
<footer class="bg-navy-950 text-slate-300">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="text-xl font-extrabold text-white">Jason Martuscello</p>
      <p class="mt-3 max-w-xs text-sm leading-6 text-slate-400">Behavioral economics, language strategy and the science of behavior change.</p>
    </div>
    <nav aria-label="Footer">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-400">Explore</p>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((n) => <li><a class="hover:text-white" href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="text-sm font-bold uppercase tracking-widest text-brand-400">Connect</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="break-all hover:text-white" href="mailto:jason.martuscello@gmail.com">jason.martuscello@gmail.com</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-6 text-center text-xs text-slate-500">© {new Date().getFullYear()} Jason Martuscello. All rights reserved.</div>
</footer>

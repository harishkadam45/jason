---
import Layout from '../layouts/Layout.astro';

const turningPoints = [
  {
    t: 'My brother’s passing gave me new life purpose',
    p: 'On December 4, 2002, I watched my 16 year old brother die from bacterial meningitis. Matt’s death taught me not to waste time on meaningless activities and to cherish every moment. Every day I look at his framed football jersey and ask: if I were to die tomorrow, would I be satisfied with my impact in the world?',
  },
  {
    t: 'I lost 100lbs and gained a deep curiosity',
    p: 'At 16, I weighed over 300lbs. With no money or social support, but a hefty appetite to change, I architected healthier habits and lost over 100lbs. That sparked a burning curiosity about how we change and sustain behavior. My story and writing has been featured in Men’s Journal, Runner’s World, Journal of Strength and Conditioning Research, Shape Magazine and The Boston Globe.',
  },
  {
    t: 'Three degrees later…',
    p: 'My education followed my curiosity for how and why I lost the weight: sociology in upstate NY, then exercise science and human movement in Florida, and onward into the science of decision-making.',
  },
];
---
<Layout title="About" description="Communications leader, SVP at maslansky + partners, and behavioral science writer.">
  <section class="bg-brand-50 py-14 sm:py-20">
    <div class="container-x max-w-4xl">
      <p class="eyebrow">About Jason</p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl">My life is driven by curiosity, solving problems and creating value.</h1>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <h2 class="text-3xl sm:text-4xl">Hi, I’m Jason Martuscello</h2>
        <div class="mt-6 rounded-2xl bg-navy-950 p-6 text-white">
          <p class="text-sm font-bold uppercase tracking-widest text-brand-400">Today</p>
          <p class="mt-2 text-lg font-semibold">Senior Vice President, maslansky + partners</p>
        </div>
      </div>
      <div class="space-y-5 text-lg leading-8">
        <p>I am a <strong class="text-navy-950">communications leader</strong> and Senior Vice President at <strong class="text-navy-950">maslansky + partners</strong>. I combine <strong class="text-navy-950">behavioral science</strong> (why people decide) with <strong class="text-navy-950">language strategy</strong> (how to move them) to find the words that make audiences listen, care, and act.</p>
        <p>For 10+ years, I’ve led communications initiatives for global brands across CPG, healthcare/pharma, financial services, tech, and the public sector, giving me a cross-industry playbook for language that actually changes decisions, not just what sounds good.</p>
        <p>Grounded in how markets work, how businesses create value, and how customers make choices, I turn complex findings into clear narratives and decision-ready guidance so words earn attention and drive action.</p>
      </div>
    </div>
  </section>

  <section class="section bg-ice-blue">
    <div class="container-x">
      <p class="eyebrow">Life’s Largest Learnings</p>
      <h2 class="mt-3 max-w-3xl text-3xl sm:text-4xl">Key turning points that shaped how I think</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {turningPoints.map((x, i) => (
          <article class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-100 font-extrabold text-brand-700">{i + 1}</span>
            <h3 class="mt-4 text-xl">{x.t}</h3>
            <p class="mt-3 leading-7">{x.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

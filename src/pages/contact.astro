---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Get in touch with Jason Martuscello.">
  <section class="bg-brand-50 section">
    <div class="container-x max-w-3xl text-center">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Want to get in touch?</h1>
      <p class="mt-5 text-lg">Email me and I’ll get back to you.</p>
      <a href="mailto:jason.martuscello@gmail.com" class="btn btn-primary mt-8 break-all !text-base">jason.martuscello@gmail.com</a>
    </div>
  </section>
</Layout>

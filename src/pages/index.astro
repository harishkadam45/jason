---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SubscribeForm from '../components/SubscribeForm.tsx';
import { articles } from '../data/articles';

const stats = [
  { n: '10+', l: 'Years leading communications' },
  { n: '8', l: 'Marathons run' },
  { n: '100', l: 'Pounds lost' },
  { n: '5', l: 'Industries served' },
];
---
<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
    <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-200/50 blur-3xl"></div>
    <div class="container-x section relative grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="eyebrow">Behavioral Economics · Language Strategy</p>
        <h1 class="mt-4 text-4xl leading-tight sm:text-5xl lg:text-7xl lg:leading-[1.05]">
          Writings, ideas and insights on <span class="text-brand-600">applied behavioral economics</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
          For business growth, better decision-making and lasting behavior change.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/about" class="btn btn-primary">Read My Story</a>
          <a href="#subscribe" class="btn btn-outline">★ Subscribe</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {stats.map((s) => (
          <div class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm sm:p-6">
            <p class="text-4xl font-extrabold text-brand-600 sm:text-5xl">{s.n}</p>
            <p class="mt-2 text-sm font-medium text-slate-600">{s.l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newest articles -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">Newest Articles</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">Fresh thinking on human behavior</h2>
        </div>
        <a href="/articles" class="text-sm font-bold text-brand-700 hover:underline">Read all articles →</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((a) => <ArticleCard a={a} />)}
      </div>
    </div>
  </section>

  <!-- Subscribe -->
  <section id="subscribe" class="scroll-mt-24 bg-navy-950 py-16 sm:py-20">
    <div class="container-x text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-400">Early access</p>
      <h2 class="mx-auto mt-3 max-w-3xl text-3xl text-white sm:text-4xl">Subscribe for early access to my latest writings, insights and ideas</h2>
      <div class="mt-8"><SubscribeForm client:load action={import.meta.env.PUBLIC_MAILCHIMP_URL} honeypot={import.meta.env.PUBLIC_MAILCHIMP_HONEYPOT} /></div>
    </div>
  </section>
</Layout>
